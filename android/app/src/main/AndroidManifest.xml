<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/vela"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/vela"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">



        </activity>

        <!-- theme-launcher-aliases:start -->
        <activity-alias android:name=".LauncherBlue" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_blue" android:roundIcon="@mipmap/vela_blue">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherChampagne" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_champagne" android:roundIcon="@mipmap/vela_champagne">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherIris" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_iris" android:roundIcon="@mipmap/vela_iris">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSlate" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_slate" android:roundIcon="@mipmap/vela_slate">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherEmerald" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_emerald" android:roundIcon="@mipmap/vela_emerald">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherCoral" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_coral" android:roundIcon="@mipmap/vela_coral">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherRuby" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_ruby" android:roundIcon="@mipmap/vela_ruby">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherCopper" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_copper" android:roundIcon="@mipmap/vela_copper">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSilver" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/app_name" android:icon="@mipmap/vela_silver" android:roundIcon="@mipmap/vela_silver">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <!-- theme-launcher-aliases:end -->

        <receiver android:name=".RecommendationAlarmReceiver" android:exported="false" />
        <receiver android:name=".RecommendationClockReceiver" android:exported="false"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/><action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/></intent-filter></receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
